# Replace api.example.com with the production API hostname after DNS points to
# this server. Caddy obtains and renews TLS certificates automatically.
api.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }

    log {
        output file /var/log/caddy/philthyparleys-access.log
        format json
    }
}
